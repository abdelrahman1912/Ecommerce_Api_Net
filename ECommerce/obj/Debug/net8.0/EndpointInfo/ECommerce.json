          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "currency"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
